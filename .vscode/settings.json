{
  "editor.rulers": [200],
  "html.format.wrapLineLength": 200,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "ngx-translate.lookup.resourcesType": "json",
  "ngx-translate.lookup.resourcesPath": "public/i18n/zh-CN.json",
  "cSpell.words": [
    "Datatable",
    "defaultnumber",
    "hsncode",
    "pricechange",
    "pricinggroup",
    "productprice",
    "productpricing",
    "ProductPricingOffers",
    "productunit",
    "quotid",
    "sodetail"
  ],
}
